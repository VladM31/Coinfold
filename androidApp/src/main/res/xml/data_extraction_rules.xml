<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Google backup or a phone-to-phone transfer: the database holds the
     user's finances and the PIN hash. The user's own backup file (Settings > Backup) is the way to move data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
